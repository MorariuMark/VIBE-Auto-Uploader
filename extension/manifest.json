{
  "manifest_version": 3,
  "name": "Auto Uploader",
  "version": "1.4.1",
  "description": "Automated batch asset uploader with stealth humanization, anti-bot event simulation, and customizable delays.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.redbubble.com/*",
    "http://*.redbubble.com/*",
    "https://*.teepublic.com/*",
    "http://*.teepublic.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Uploader v1.4.1"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.redbubble.com/portfolio/images/new*",
        "https://*.redbubble.com/portfolio/images/*",
        "https://*.teepublic.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
