{
  "manifest_version": 3,
  "name": "Auto Uploader",
  "version": "1.2.8",
  "description": "Automated batch asset uploader with IndexedDB on-demand image loading and humanization pauses.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.redbubble.com/*",
    "http://*.redbubble.com/*",
    "https://*.teepublic.com/*",
    "http://*.teepublic.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Uploader v1.2.8"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["tp_enable_products.js"],
      "matches": ["https://*.teepublic.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.redbubble.com/portfolio/images/new*",
        "https://*.redbubble.com/portfolio/images/*",
        "https://*.teepublic.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
